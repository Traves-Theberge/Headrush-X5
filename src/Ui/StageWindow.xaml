<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="X5 Control" Width="1320" Height="900" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#0B0D11" Foreground="#F2F3F5" FontFamily="Segoe UI">
  <Window.Resources>
    <LinearGradientBrush x:Key="Chassis" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#32333A" Offset="0"/><GradientStop Color="#1B1C22" Offset="0.55"/><GradientStop Color="#2D2D34" Offset="1"/></LinearGradientBrush>
    <RadialGradientBrush x:Key="Steel"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#D8DDE0" Offset="0.4"/><GradientStop Color="#838C94" Offset="0.76"/><GradientStop Color="#42474B" Offset="1"/></RadialGradientBrush>
    <Style TargetType="Button"><Setter Property="Background" Value="#252B33"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderBrush" Value="#454C56"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#11161C"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderBrush" Value="#4B5660"/><Setter Property="Padding" Value="7"/><Setter Property="MinHeight" Value="33"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#E4E8EB"/><Setter Property="Foreground" Value="#12171C"/><Setter Property="MinHeight" Value="33"/></Style>
    <Style x:Key="FootswitchStyle" TargetType="Button"><Setter Property="Background" Value="{StaticResource Steel}"/><Setter Property="Foreground" Value="#41484F"/><Setter Property="BorderBrush" Value="#AEB8BE"/><Setter Property="BorderThickness" Value="5"/><Setter Property="FontSize" Value="37"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="55"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#12161C" BorderBrush="#303741" BorderThickness="0,0,0,1"><Grid Margin="30,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="HEADRUSH" FontSize="17" FontWeight="Black"/><TextBlock Text="  X5 CONTROL" Foreground="#B3BAC3" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="VxTab" Content="VX5" Background="#19614E" Margin="0,0,8,0"/><Button x:Name="MxTab" Content="MX5"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#68E9B5" FontSize="18" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="SideStatus" Text="Checking VX5..." Foreground="#C4CCD2" VerticalAlignment="Center" FontSize="12"/><Button x:Name="RefreshButton" Content="↻" FontSize="18" Padding="12,5" Margin="18,0,0,0"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="24,12,24,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PageEyebrow" Text="HEADRUSH / VX5" Foreground="#67DDB4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="  /  " Foreground="#69737B" VerticalAlignment="Center"/><TextBlock x:Name="PageTitle" Text="Stage" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="PageSub" Text="Hands-on control for the connected pedal." Foreground="#929DA6" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
      <Grid Grid.Row="1" x:Name="VxPage"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0"><Button x:Name="MenuHome" Content="←  PEDAL VIEW" Width="140" Margin="0,0,20,0" Background="#303C46"/><Button x:Name="MenuPreset" Content="PRESET" Width="130" Margin="0,0,8,0"/><Button x:Name="MenuKey" Content="KEY" Width="130" Margin="0,0,8,0"/><Button x:Name="MenuAutoTune" Content="AUTO-TUNE" Width="130" Margin="0,0,8,0"/><Button x:Name="MenuHarmony" Content="HARMONY" Width="130" Margin="0,0,8,0"/><Button x:Name="MenuFx" Content="FX" Width="130" Margin="0,0,20,0"/><Button x:Name="AdvancedButton" Content="ADVANCED" Width="130"/></StackPanel><Grid Grid.Row="1" x:Name="VxStage">
        <Border Background="#080A0D" CornerRadius="30" BorderBrush="#49505A" BorderThickness="3" Padding="10" Width="950" HorizontalAlignment="Center" VerticalAlignment="Stretch"><Border Background="{StaticResource Chassis}" CornerRadius="22" BorderBrush="#5B6069" BorderThickness="1" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="205"/><RowDefinition Height="198"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
          <Grid Grid.Row="0" Grid.ColumnSpan="3"><TextBlock Text="HEADRUSH" FontSize="21" FontWeight="Black" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#6DDDB5" FontSize="12" Margin="0,0,7,0"/><TextBlock x:Name="VxConnection" Text="Connecting..." Foreground="#DADEE3" FontSize="12"/><TextBlock Text="    VX5" FontSize="19" FontWeight="Black" Margin="12,0,0,0"/></StackPanel></Grid>
          <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center"><TextBlock Text="VOLUME" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/><Border x:Name="VolumeKnob" Width="112" Height="112" CornerRadius="56" BorderBrush="#0D0F12" BorderThickness="11" Margin="0,8,0,4" Background="{StaticResource Steel}"><Grid><Grid x:Name="VolumeDial" RenderTransformOrigin="0.5,0.5"><Border Width="4" Height="25" Background="#26343D" CornerRadius="2" VerticalAlignment="Top" Margin="0,5,0,0"/></Grid><Ellipse Width="44" Height="44" Fill="#FFFFFF" Opacity="0.12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" IsHitTestVisible="False"/></Grid></Border><TextBlock x:Name="PedalVolumeValue" Text="—" Foreground="#8DF6D1" HorizontalAlignment="Center" FontSize="12"/><StackPanel Orientation="Horizontal"><Slider x:Name="PedalVolumeSlider" Width="110" Minimum="0" Maximum="1"/><Button x:Name="PedalVolumeSet" Content="SET" FontSize="10" Padding="5,3" Margin="6,0,0,0"/></StackPanel></StackPanel>
          <Border Grid.Row="1" Grid.Column="1" Background="#070A10" CornerRadius="12" BorderBrush="#6A717B" BorderThickness="8" Margin="10,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="HEADRUSH  /  AUTO-TUNE" Foreground="#58DBCB" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/><StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="PedalPresetDisplay" Text="—" FontSize="61" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="PedalPresetName" Text="PRESET UNKNOWN" Foreground="#DDE8ED" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel><TextBlock Grid.Row="2" x:Name="PedalKeyDisplay" Text="KEY —   ·   SCALE —" Foreground="#FF7C76" FontSize="15" HorizontalAlignment="Center"/></Grid></Border>
          <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="PRESET / EDIT" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/><Border Width="112" Height="112" CornerRadius="56" BorderBrush="#0D0F12" BorderThickness="11" Margin="0,8,0,4" Background="{StaticResource Steel}"><Grid><Grid x:Name="PresetDial" RenderTransformOrigin="0.5,0.5"><Border Width="4" Height="25" Background="#26343D" CornerRadius="2" VerticalAlignment="Top" Margin="0,5,0,0"/></Grid><Ellipse Width="44" Height="44" Fill="#FFFFFF" Opacity="0.12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" IsHitTestVisible="False"/></Grid></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBox x:Name="VxPreset" Text="1" Width="55" HorizontalContentAlignment="Center"/><Button x:Name="VxRecall" Content="LOAD" Background="#216B56" Padding="10,5" Margin="5,0,0,0"/></StackPanel></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center"><TextBlock Text="SPEED" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/><Border x:Name="SpeedKnob" Width="96" Height="96" CornerRadius="48" BorderBrush="#0D0F12" BorderThickness="10" Margin="0,6,0,4" Background="{StaticResource Steel}"><Grid x:Name="SpeedDial" RenderTransformOrigin="0.5,0.5"><Border Width="4" Height="22" Background="#26343D" CornerRadius="2" VerticalAlignment="Top" Margin="0,5,0,0"/></Grid></Border><TextBlock x:Name="PedalSpeedValue" Text="—" Foreground="#8DF6D1" HorizontalAlignment="Center" FontSize="12"/><StackPanel Orientation="Horizontal"><Slider x:Name="PedalSpeedSlider" Width="110" Minimum="0" Maximum="400"/><Button x:Name="PedalSpeedSet" Content="SET" FontSize="10" Padding="5,3" Margin="6,0,0,0"/></StackPanel></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="PedalPrev" Content="PRESET  −" Width="104" Margin="0,0,10,0"/><Button x:Name="PedalNext" Content="PRESET  +" Width="104"/></StackPanel><TextBlock Text="KEY  /  SCALE" Foreground="#AEB9BF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,5"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ComboBox x:Name="PedalKeyCombo" Width="76" Margin="0,0,5,0"/><ComboBox x:Name="PedalScaleCombo" Width="142" Margin="0,0,5,0"/><Button x:Name="PedalSetKeyScale" Content="APPLY" Background="#216B56" FontSize="10"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button x:Name="PedalAutoTune" Content="AUTO-TUNE" Background="#146B4D" Margin="0,0,8,0"/><Button x:Name="PedalHarmony" Content="HARMONY" Margin="0,0,8,0"/><Button x:Name="PedalFx" Content="FX"/></StackPanel><TextBlock x:Name="VxVersion" Text="" Foreground="#AAB2BA" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="HUMANIZE" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/><Border x:Name="HumanizeKnob" Width="96" Height="96" CornerRadius="48" BorderBrush="#0D0F12" BorderThickness="10" Margin="0,6,0,4" Background="{StaticResource Steel}"><Grid x:Name="HumanizeDial" RenderTransformOrigin="0.5,0.5"><Border Width="4" Height="22" Background="#26343D" CornerRadius="2" VerticalAlignment="Top" Margin="0,5,0,0"/></Grid></Border><TextBlock x:Name="PedalHumanizeValue" Text="—" Foreground="#8DF6D1" HorizontalAlignment="Center" FontSize="12"/><StackPanel Orientation="Horizontal"><Slider x:Name="PedalHumanizeSlider" Width="110" Minimum="0" Maximum="100"/><Button x:Name="PedalHumanizeSet" Content="SET" FontSize="10" Padding="5,3" Margin="6,0,0,0"/></StackPanel></StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▼" FontSize="24" HorizontalAlignment="Center"/><Button x:Name="StageAb" Style="{StaticResource FootswitchStyle}" Content="◉" Width="110" Height="110"/><TextBlock Text="A/B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Antares" FontSize="25" FontWeight="Bold" FontStyle="Italic" Foreground="#CFD4D9" HorizontalAlignment="Center"/><TextBlock Text="AUTO-TUNE" FontSize="34" FontWeight="Black" Foreground="#E6E9ED" HorizontalAlignment="Center"/><TextBlock Text="VX5 · REMOTE PERFORMANCE" FontSize="11" Foreground="#8C979E" HorizontalAlignment="Center"/></StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▲" FontSize="24" HorizontalAlignment="Center"/><Button x:Name="StageTalk" Style="{StaticResource FootswitchStyle}" Content="◉" Width="110" Height="110"/><TextBlock Text="TALK" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
        </Grid></Border></Border>
      </Grid>
      <Grid Grid.Row="1" x:Name="VxEditor" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Border Background="#141A20" CornerRadius="14" BorderBrush="#313A43" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="20,0"><TextBlock x:Name="EditorHeading" Text="VX5 LIVE PARAMETERS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="ParameterCount" Foreground="#8DA1A9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterPanel" Margin="16,0,18,20"/></ScrollViewer></Grid></Border><ScrollViewer x:Name="VxActionsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#19222B" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="PRESET RECALL" FontWeight="Bold"/><TextBlock Text="Enter 1–250" Foreground="#A3B0B7" Margin="0,8,0,8"/><TextBox Text="Use the LOAD control on the pedal view" IsReadOnly="True" FontSize="11"/></StackPanel></Border><Border Background="#19222B" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="A/B MODE" FontWeight="Bold"/><WrapPanel Margin="0,10,0,0"><Button x:Name="VxAbOff" Content="Off" Margin="0,0,7,0"/><Button x:Name="VxAbA" Content="A" Margin="0,0,7,0"/><Button x:Name="VxAbB" Content="B"/></WrapPanel><TextBlock Text="TALK MODE" FontWeight="Bold" Margin="0,18,0,0"/><WrapPanel Margin="0,10,0,0"><Button x:Name="VxTalkOff" Content="Off" Margin="0,0,7,0"/><Button x:Name="VxTalkOn" Content="On"/></WrapPanel></StackPanel></Border><Border Background="#19222B" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="MIDI OUTPUT" FontWeight="Bold"/><TextBlock Text="Select the VX5 endpoint for preset and mode commands." TextWrapping="Wrap" Foreground="#A3B0B7" Margin="0,8,0,12"/><ComboBox x:Name="VxMidi"/><Button x:Name="RefreshMidi" Content="Scan MIDI ports" Margin="0,10,0,0" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>
      <Grid Grid.Row="1" x:Name="VxKeyMenu" Visibility="Collapsed">
        <Border Background="#151B22" CornerRadius="15" BorderBrush="#343E48" BorderThickness="1" Padding="36" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Width="660">
            <TextBlock Text="KEY / SCALE" Foreground="#67DDB4" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Set the song's pitch center and the notes Auto-Tune follows." FontSize="21" FontWeight="SemiBold" Margin="0,12,0,30" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="60"/><RowDefinition Height="60"/></Grid.RowDefinitions>
              <TextBlock Text="KEY" VerticalAlignment="Center" Foreground="#A7B5BE" FontWeight="Bold"/><ComboBox x:Name="MenuKeyCombo" Grid.Column="1" VerticalAlignment="Center"/>
              <TextBlock Text="SCALE" Grid.Row="1" VerticalAlignment="Center" Foreground="#A7B5BE" FontWeight="Bold"/><ComboBox x:Name="MenuScaleCombo" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
              <TextBlock Text="RANGE" Grid.Row="2" VerticalAlignment="Center" Foreground="#A7B5BE" FontWeight="Bold"/><ComboBox x:Name="MenuRangeCombo" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
            <Button x:Name="MenuApplyKey" Content="APPLY TO VX5" Background="#216B56" HorizontalAlignment="Left" Margin="110,22,0,0" Padding="22,10"/>
            <TextBlock x:Name="MenuKeyReadback" Text="Connect the VX5 to read its current key and scale." Foreground="#99ADB5" Margin="110,18,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1" x:Name="VxPresets" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#151B22" CornerRadius="15" BorderBrush="#343E48" BorderThickness="1" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PRESET LIBRARY" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/><TextBox Grid.Row="1" x:Name="PresetSearch" Margin="0,0,0,12" ToolTip="Search preset number or name"/><ListBox Grid.Row="2" x:Name="PresetList" Background="#0F141A" Foreground="#E8EEF1" BorderBrush="#34424B" FontSize="14" Padding="8"/></Grid></Border>
        <Border Grid.Column="2" Background="#151B22" CornerRadius="15" BorderBrush="#343E48" BorderThickness="1" Padding="27"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="PresetNumberTitle" Text="PRESET 001" FontSize="31" FontWeight="Bold"/><TextBlock x:Name="PresetSource" Text="Factory label from the VX5 user guide" Foreground="#8EE8C0" Margin="0,5,0,20"/><TextBlock Text="PRESET NAME" FontSize="11" FontWeight="Bold" Foreground="#A7B5BE"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBox x:Name="PresetNameInput" Width="300" FontSize="17"/><Button x:Name="PresetSaveName" Content="SAVE NAME IN APP" Margin="10,0,0,0" Background="#216B56"/></StackPanel><TextBlock Text="Device preset names are not exposed over USB. Names edited here stay in this PC library." Foreground="#8998A0" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,30"/><TextBlock Text="ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#A7B5BE"/><WrapPanel Margin="0,13,0,0"><Button x:Name="PresetLoad" Content="LOAD ON VX5" Background="#216B56" Margin="0,0,8,8"/><Button x:Name="PresetCreate" Content="CREATE CUSTOM PATCH" Background="#31594F" Margin="0,0,8,8"/><Button x:Name="PresetCapture" Content="CAPTURE LIVE SOUND" Margin="0,0,8,8"/><Button x:Name="PresetEdit" Content="EDIT SAVED SETTINGS" Margin="0,0,8,8"/><Button x:Name="PresetApply" Content="APPLY SETTINGS LIVE" Margin="0,0,8,8"/></WrapPanel><Border Background="#202B33" CornerRadius="10" Padding="16" Margin="0,18,0,0"><StackPanel><TextBlock Text="SAVED PARAMETER SNAPSHOT" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="PresetStateCount" Text="No snapshot yet" Foreground="#A8BAC1" FontSize="13" Margin="0,8,0,0"/><TextBlock Text="Load this slot, then capture the live sound. Edit the saved settings here and apply them to the loaded slot. Saving on the pedal still uses its Preset/Edit control." Foreground="#8798A1" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Border>
      </Grid>
      </Grid>
      <Grid Grid.Row="1" x:Name="MxPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#19222B" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="MX5 MIDI CONTROL" Foreground="#67DDB4" FontWeight="Bold"/><TextBlock Text="Connect a USB MIDI interface to the MX5’s 3.5 mm MIDI input." FontSize="17" Margin="0,6,0,0"/><TextBlock Text="The connected MX5 will be verified in a later hardware pass." Foreground="#A3B0B7" Margin="0,4,0,0"/></StackPanel></Border><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="MxCards"/></ScrollViewer></Grid>
    </Grid>
    <Border Grid.Row="2" Background="#12161C" BorderBrush="#303741" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusLine" Text="Ready" Foreground="#98A6AD" VerticalAlignment="Center" Margin="30,0" FontSize="12"/></Border>
  </Grid>
</Window>
